# LOCAL COMMAND BOT — CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env hoặc cấu hình thông qua Giao diện Quản lý API Key trên ứng dụng.

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Groq API Key (Ultra-fast LPU inference: Llama 3.3, Mixtral)
GROQ_API_KEY=

# OpenRouter API Key (Multi-cloud aggregator)
OPENROUTER_API_KEY=

# DeepSeek API Key
DEEPSEEK_API_KEY=

# Custom Gateway / Ollama URL (Tùy chọn)
CUSTOM_GATEWAY_URL=http://localhost:11434/v1
DEFAULT_MAX_CONCURRENCY=3
DEFAULT_BUDGET_LIMIT=5.0
DEFAULT_MAX_RETRIES=3
DEFAULT_TIMEOUT_SECONDS=90
